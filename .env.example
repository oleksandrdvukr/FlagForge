# Copy to .env and adjust. See docs/02-design.md §10.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=flagforge
POSTGRES_PASSWORD=flagforge
POSTGRES_DB=flagforge
POSTGRES_PORT=5432

# --- API ---
# Tests use the same server with "_test" appended to the database name (override: TEST_DATABASE_URL).
DATABASE_URL=postgresql://flagforge:flagforge@localhost:5432/flagforge
DATABASE_POOL_SIZE=10
PORT=3000
NODE_ENV=development

# HS256 signing secret, at least 32 characters (SEC-02).
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more

# Single bootstrap admin (ADR-0006). Generate the hash with bcrypt (cost 12).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
