# Copy to .env and adjust. See docs/02-design.md §10.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=flagforge
POSTGRES_PASSWORD=flagforge
POSTGRES_DB=flagforge
POSTGRES_PORT=5432

# --- API ---
# Tests use the same server with "_test" appended to the database name (override: TEST_DATABASE_URL).
DATABASE_URL=postgresql://flagforge:flagforge@localhost:5432/flagforge
DATABASE_POOL_SIZE=10
PORT=3000

# Evaluation requests per minute per SDK key (SEC-04). Default: 1000.
RATE_LIMIT_PER_MINUTE=1000

# Secure session cookie; set to true when served over HTTPS. Default: true when NODE_ENV=production.
# COOKIE_SECURE=true
NODE_ENV=development

# HS256 signing secret, at least 32 characters (SEC-02).
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more

# Single bootstrap admin (ADR-0006). Generate the hash (cost 12) from apps/api:
#   node -e "console.log(require('bcrypt').hashSync(process.argv[1], 12))" 'your-password'
# Keep the single quotes: the hash contains '$', which docker compose would otherwise interpolate.
ADMIN_EMAIL=admin@flagforge.local
# Demo value = hash of "flagforge-demo". Replace before real use.
ADMIN_PASSWORD_HASH='$2b$12$D1a9YUELlee7lETFaRdGUOQ9.lHXW0jsoXYivSzAkvbWKIKvE4PE6'
